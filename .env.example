NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017/task_management
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret-32-chars
JWT_ISSUER=task-management-api
JWT_AUDIENCE=task-management-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
JSON_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=10000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300
